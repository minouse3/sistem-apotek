# HTTP ports: direct Go listener and Compose host mapping
PORT=8080
APP_HOST_PORT=8080
APP_ENV=development

# PostgreSQL container credentials and host port
POSTGRES_USER=apotek
POSTGRES_PASSWORD=apotek_dev_password
POSTGRES_DB=sistem_apotek
DB_PORT=5432

# Direct Go connection; keep credentials and port in sync with the values above
DB_DSN=postgres://apotek:apotek_dev_password@localhost:5432/sistem_apotek?TimeZone=Asia/Jakarta

# Session token signing/pepper secret
SESSION_SECRET=change-me-in-production
